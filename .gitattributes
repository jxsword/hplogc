# 默认：自动识别文本；仓库内统一 LF，工作区也用 LF
* text=auto eol=lf

# Windows 批处理/命令脚本：工作区用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 常见需要 LF 的脚本/配置（其实已被上面默认覆盖，可写可不写）
*.sh text eol=lf
*.ps1 text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# 二进制文件不要做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.pdf binary